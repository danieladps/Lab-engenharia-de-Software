# Configuração do Docker (docker compose up). Copie para .env e preencha.
# O .env fica só no seu computador: ele está no .gitignore e não vai para o GitHub.

# Senha do Postgres que roda no Docker (só para uso local). Use só letras e números.
POSTGRES_PASSWORD=

# Chave que assina os logins (mínimo 32 caracteres). Gere uma com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Opcional: senha das contas de demonstração. Se ficar vazia, o seed gera uma e mostra no log.
DEMO_USER_PASSWORD=
