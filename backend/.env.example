DATABASE_URL=sqlite:///./petlume_mvp.db
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true

# Obrigatória: chave que assina os logins (mínimo 32 caracteres).
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Validade do login em minutos (padrão: 1 dia).
JWT_EXPIRE_MINUTES=1440

# Opcional: senha das contas de demonstração. Se ficar vazia, o seed gera uma.
DEMO_USER_PASSWORD=

# Opcional: chave da Google Places API (página "Onde adotar").
# Crie em console.cloud.google.com > APIs e serviços > ative "Places API (New)" > Credenciais.
# Restrinja a chave para usar só a Places API. Nunca coloque no frontend.
GOOGLE_PLACES_API_KEY=
# Máximo de buscas no Google por dia (protege a cota gratuita).
PLACES_DAILY_LIMIT=200
