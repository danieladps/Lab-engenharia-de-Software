DATABASE_URL=sqlite:///./petlume_mvp.db
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true

# Obrigatória: chave que assina os logins (mínimo 32 caracteres).
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Validade do login em minutos (padrão: 1 dia).
JWT_EXPIRE_MINUTES=1440

# Opcional: senha das contas de demonstração. Se ficar vazia, o seed gera uma.
DEMO_USER_PASSWORD=
